DATABASE_URL=
DIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Stripe (test keys: sk_test_*/pk_test_*; production: sk_live_*/pk_live_*)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in dev
# In prod, create a webhook endpoint in Stripe Dashboard pointing to /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
