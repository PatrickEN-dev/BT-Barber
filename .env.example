## Database (Supabase pooler — sa-east-1)
# Username for pooler URLs is `postgres.<project_ref>`. Use port 6543 for runtime
# (pgbouncer) and 5432 for migrations.
DATABASE_URL=
DIRECT_URL=

## Google OAuth (NextAuth)
# Google Cloud Console > Credentials > OAuth 2.0 Client.
# Authorized redirect URIs in prod: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## NextAuth
# In prod: https://<your-domain> (NO trailing slash). Localhost is fine in dev.
NEXTAUTH_URL=
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

## Stripe (test keys: sk_test_*/pk_test_*; production: sk_live_*/pk_live_*)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Dev: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints the whsec_*.
# Prod: Stripe Dashboard > Developers > Webhooks > Add endpoint pointing to
# https://<your-domain>/api/webhooks/stripe — copy the signing secret here.
# Required events: payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled, charge.refunded.
STRIPE_WEBHOOK_SECRET=

## Cron auth
# Bearer token guarding /api/cron/* endpoints (booking hold cleanup, etc).
# On Vercel, set this and Vercel cron will inject `Authorization: Bearer ${CRON_SECRET}`
# automatically when calling the scheduled endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=

## Platform admin allowlist (optional but required to record payouts)
# Comma-separated emails. Only these accounts can call `recordPayout`.
# Example: PLATFORM_ADMIN_EMAILS=patrick@bt-barber.com.br,ops@bt-barber.com.br
PLATFORM_ADMIN_EMAILS=
