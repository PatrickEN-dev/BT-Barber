generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  BARBER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum ProductCategory {
  DRINK
  HAIR_CARE
  BEARD_CARE
  ACCESSORY
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
}

enum PaymentStatus {
  PENDING        // PaymentIntent created, awaiting payment
  PAID           // Webhook confirmed payment
  FAILED         // Card declined or processing failed
  EXPIRED        // PIX QR expired before payment
  REFUNDED       // Full refund processed
  PARTIAL_REFUND // Partial refund (cancellation fee retained)
  CANCELED       // Manual cancel before payment attempt
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  role          UserRole           @default(CUSTOMER)
  theme         Theme              @default(SYSTEM)
  accounts      Account[]
  sessions      Session[]
  Booking       Booking[]
  ownedShops    Barbershop[]       @relation("ShopOwner")
  barberProfile Barber?            @relation("BarberAccount")
  notesAbout    BarberClientNote[] @relation("ClientNotes")
  Order         Order[]
  Payment       Payment[]
  auditLogs     AuditLog[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Barbershop {
  id        String    @id @default(uuid())
  name      String
  address   String
  phone     String?
  imageUrl  String
  hasShop   Boolean   @default(true)
  Service   Service[]
  Booking   Booking[]
  ownerId   String?
  owner     User?     @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  Barbers   Barber[]
  Products  Product[]
  Orders    Order[]
  Payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
}

model Service {
  id             String           @id @default(uuid())
  name           String
  price          Decimal          @db.Decimal(10, 2)
  description    String
  imageUrl       String
  barbershopId   String
  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  BookingService BookingService[]
  Barbers        Barber[]         @relation("BarberServices")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([barbershopId])
}

model Booking {
  id           String           @id @default(uuid())
  date         DateTime
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId String
  barbershop   Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  barberId     String
  barber       Barber           @relation(fields: [barberId], references: [id], onDelete: Cascade)
  services     BookingService[]
  payment      Payment?
  noShow       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([barberId, date])
  @@unique([userId, date])
  @@index([barbershopId, date])
}

model BookingService {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, serviceId])
  @@index([serviceId])
}

model Barber {
  id           String             @id @default(uuid())
  name         String
  description  String?
  rating       Float?             @default(0)
  imageUrl     String?
  barbershopId String
  barbershop   Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  userId       String?            @unique
  user         User?              @relation("BarberAccount", fields: [userId], references: [id], onDelete: SetNull)
  services     Service[]          @relation("BarberServices")
  Booking      Booking[]
  blocks       BarberBlock[]
  clientNotes  BarberClientNote[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([barbershopId])
}

model BarberBlock {
  id        String   @id @default(uuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barberId, startAt])
}

model BarberClientNote {
  id        String   @id @default(uuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  clientId  String
  client    User     @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barberId, clientId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId String?
  action       String
  targetType   String?
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([barbershopId, createdAt])
  @@index([targetType, targetId])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model Product {
  id           String          @id @default(cuid())
  barbershopId String
  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  imageUrl     String
  price        Decimal         @db.Decimal(10, 2)
  stock        Int             @default(0)
  category     ProductCategory @default(OTHER)
  active       Boolean         @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([barbershopId])
  @@index([barbershopId, active])
  @@index([barbershopId, category])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?
  items        OrderItem[]
  payment      Payment?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([barbershopId, status])
  @@index([barbershopId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  externalId      String?       @unique // Stripe payment_intent_id
  amount          Decimal       @db.Decimal(10, 2)
  refundedAmount  Decimal       @default(0) @db.Decimal(10, 2)
  currency        String        @default("BRL")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  // XOR: payment is for either a booking or an order, never both.
  bookingId       String?       @unique
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  orderId         String?       @unique
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId    String
  barbershop      Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Restrict)

  // PIX-specific (null for card payments)
  qrCodeImage     String?       @db.Text // base64 data URL
  qrCodeText      String?       @db.Text // copy-paste code
  expiresAt       DateTime?

  // Lifecycle timestamps
  paidAt          DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  failureReason   String?

  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([barbershopId, status])
  @@index([status, expiresAt])
}
